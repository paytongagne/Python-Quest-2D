{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonquest.local/contracts/v1/travel_request.schema.json",
  "title": "travel_request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "from_zone",
    "to_zone",
    "source",
    "preview"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "from_zone": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "to_zone": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "source": {
      "enum": [
        "starmap",
        "journal",
        "physical_exit",
        "quest_script"
      ]
    },
    "preview": {
      "type": "boolean"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    }
  }
}
