{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pythonquest.local/contracts/v1/observation.schema.json",
  "title": "observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "world_id",
    "robot",
    "visible",
    "objective",
    "rules"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "world_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cell",
        "energy",
        "abilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "cell": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "energy": {
          "type": "integer",
          "minimum": 0
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 512
        }
      }
    },
    "visible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "walls",
        "devices"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "maxItems": 8192
        },
        "devices": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "cell",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "cell": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "integer",
                    "minimum": 0
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "state": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                },
                "uniqueItems": true,
                "maxItems": 512
              }
            }
          }
        }
      }
    },
    "objective": {
      "type": "object",
      "required": [
        "target_id",
        "required_state"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "required_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "step_energy",
        "scan_energy"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "step_energy": {
          "type": "integer",
          "minimum": 0
        },
        "scan_energy": {
          "type": "integer",
          "minimum": 0
        },
        "interact_energy": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
